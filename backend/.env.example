# Interact AI Backend Configuration Template
# ------------------------------------------
# DO NOT ADD SECRETS TO THIS FILE

# --- Application ---
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=insecure-default-key-change-me

# --- Database & Caching ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interact_db
REDIS_URL=redis://localhost:6379/0

# --- Frontend Connection ---
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://interacai.com

# --- AI Providers ---
# OpenRouter
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_REFERER=https://interacai.com
OPENROUTER_TITLE="Interact AI Platform"
COST_PER_TOKEN=0.000002

# Gemini (Fallback/Alternatives)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-pro

# --- WhatsApp API ---
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN
WHATSAPP_API_TOKEN=YOUR_WHATSAPP_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID

# --- Payments (Paystack) ---
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY

# --- Push Notifications / WebPush ---
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:admin@yourdomain.com