# Interact AI Frontend - Production Settings
# ------------------------------------------

# API Server URL (Targeting production Render backend or custom domain)
REACT_APP_API_URL=https://interact-backend-staging.onrender.com

# Production Firebase Config (Obtained from Production Firebase project console)
REACT_APP_FIREBASE_API_KEY=YOUR_PRODUCTION_FIREBASE_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=interacai-prod.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=interacai-prod
REACT_APP_FIREBASE_STORAGE_BUCKET=interacai-prod.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=YOUR_PRODUCTION_FIREBASE_MESSAGING_SENDER_ID
REACT_APP_FIREBASE_APP_ID=YOUR_PRODUCTION_FIREBASE_APP_ID
